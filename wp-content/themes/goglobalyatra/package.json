{
  "name": "goglobalyatra-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for the Goglobal Yatra WordPress theme.",
  "scripts": {
    "build": "tailwindcss -i ./assets/src/input.css -o ./assets/dist/style.css --minify",
    "watch": "tailwindcss -i ./assets/src/input.css -o ./assets/dist/style.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "@tailwindcss/typography": "^0.5.15"
  }
}
